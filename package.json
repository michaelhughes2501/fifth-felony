{
  "name": "reentry-support-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/lib/request-validation.test.ts src/lib/reentry-tools.test.ts && node --test tests/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-neon.mjs",
    "db:seed:resources": "node --env-file-if-exists=.env.local scripts/seed-resources-neon.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-knowledge.mjs",
    "postinstall": "node scripts/patch-postcss.mjs"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neondatabase/serverless": "^1.0.2",
    "@supabase/ssr": "0.12.7",
    "@tailwindcss/postcss": "4.3.5",
    "next": "16.4.6",
    "openai": "6.45.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
