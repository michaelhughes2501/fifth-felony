# Copy to .env.local, then set real credentials. Never commit secrets.
# Use the pooled or direct Neon connection string with TLS verification enabled.
DATABASE_URL=postgresql://user:[REDACTED]@ep-example.region.aws.neon.tech/database?sslmode=verify-full

# Neon Managed Auth. NEXT_PUBLIC_ URL is only the public service endpoint.
NEXT_PUBLIC_NEON_AUTH_BASE_URL=https://your-branch.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=https://your-branch.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-a-random-secret-of-at-least-32-characters

# Needed by the AI assistant and embedding seeder.
OPENAI_API_KEY=your-openai-api-key

NODE_ENV=development
NEXTAUTH_URL=http://localhost:3002
